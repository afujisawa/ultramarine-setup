{
  // ============================================================
  // Extensions
  // ============================================================
  "auto_install_extensions": {
    "tokyo-night": true,
    "colored-zed-icons-theme": true,
    "git-firefly": true,
  },

  // ============================================================
  // Appearance
  // ============================================================
  "theme": "Tokyo Night Storm",
  "icon_theme": "Colored Zed Icons Theme Dark",
  "buffer_font_family": "JetBrains Mono Nerd Font",
  "buffer_font_size": 14.0,
  "buffer_line_height": "comfortable",
  "minimap": {
    "max_width_columns": 50,
    "show": "always",
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "active_pane_modifiers": {
    "inactive_opacity": 1.0,
  },

  // ============================================================
  // Editor behavior
  // ============================================================
  "cli_default_open_behavior": "existing_window",
  "current_line_highlight": "all",
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "tabs": {
    "git_status": true,
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 3,
    "coloring": "indent_aware",
  },
  // ============================================================
  // Vim mode
  // ============================================================
  "vim_mode": true,
  "vim": {
    "cursor_shape": {
      "normal": "bar",
    },
    "toggle_relative_line_numbers": true,
  },

  // ============================================================
  // Language servers
  // ============================================================
  "lsp": {
    "bash-language-server": {
      "settings": {
        "bashIde": {
          "shellcheckPath": "shellcheck",
        },
      },
    },
  },

  // ============================================================
  // Language settings
  // ============================================================
  "languages": {
    "Shell Script": {
      "tab_size": 4,
      "hard_tabs": true,
      "preferred_line_length": 80,
      "show_wrap_guides": true,
      "wrap_guides": [80],
      "soft_wrap": "none",
      "format_on_save": "on",
      "remove_trailing_whitespace_on_save": true,
      "ensure_final_newline_on_save": true,
      "language_servers": ["bash-language-server"],
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["-i", "0", "-ci", "-bn"],
        },
      },
    },
    "C": {
      "tab_size": 4,
      "hard_tabs": true,
      "preferred_line_length": 80,
      "show_wrap_guides": true,
      "wrap_guides": [80],
      "soft_wrap": "none",
      "format_on_save": "on",
      "remove_trailing_whitespace_on_save": true,
      "ensure_final_newline_on_save": true,
      "formatter": {
        "external": {
          "command": "clang-format",
          "arguments": ["--assume-filename", "{buffer_path}"],
        },
      },
    },
  },

  // ============================================================
  // Terminal
  // ============================================================
  "terminal": {
    "env": {
      "IN_ZED": "1",
    },
  },

  // ============================================================
  // AI assistants
  // ============================================================
  "disable_ai": false,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },

  // ============================================================
  // Git
  // ============================================================
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
    },
  },

  // ============================================================
  // Telemetry
  // ============================================================
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
